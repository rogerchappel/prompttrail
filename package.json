{
  "name": "prompttrail",
  "version": "0.1.0",
  "description": "Privacy-first JSONL receipt ledger for local agent work.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "prompttrail": "./dist/run.js",
    "pt": "./dist/run.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "smoke": "bash scripts/smoke.sh",
    "package:smoke": "bash scripts/package-smoke.sh",
    "release:check": "npm test && npm run smoke && npm run package:smoke",
    "release:validate": "node scripts/validate-release.mjs",
    "release:workflow": "node scripts/validate-release-workflow.mjs && node scripts/validate-release-recovery-workflow.mjs",
    "release:recover": "node scripts/recover-release.mjs"
  },
  "keywords": [
    "agent",
    "audit-log",
    "cli",
    "jsonl",
    "ledger",
    "local-first",
    "privacy",
    "receipts"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/prompttrail.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/prompttrail/issues"
  },
  "homepage": "https://github.com/rogerchappel/prompttrail#readme"
}
